@page "/"
@using AzureMoe.Chat.Web.Services
@inject IJSRuntime JS
@inject AssetLoader AssetLoader
@inject JsGraphStore GraphStore
@inject JsEmbedder Embedder
@inject JsLlmEngine LlmEngine
@inject RagPipeline Rag
@inject AppConfig Cfg
@implements IAsyncDisposable

<PageTitle>AzureMoe Chat</PageTitle>

@if (!_accepted)
{
    <div class="splash">
        <pre class="splash-logo">   _                      __  __
  /_\   _____  _ _ ___   |  \/  |___  ___
 / _ \ |_ / || | '_/ -_) | |\/| / _ \/ -_)
/_/ \_\/__/\_,_|_| \___| |_|  |_\___/\___|
      Chat — powered by GraphRAG</pre>
        <div class="splash-desc">GraphRAG + ブラウザ内 LLM</div>
        <button class="splash-accept" @onclick="AcceptAsync">Accept</button>
        <footer class="app-footer splash-footer">
            <a class="url" href="terms.html" target="_blank" rel="noopener">利用規約 (Terms of Use)</a>
            <span class="copyright">© 2026 kosmos.ebi</span>
        </footer>
    </div>
}
else
{
<div class="terminal" @ref="_terminalRef">
    <div class="output" id="chat-output" @ref="_outputRef">
        @foreach (var line in _lines)
        {
            <div class="line @line.Css">@((MarkupString)line.Html)</div>
        }
        @if (_streamBuf.Length > 0)
        {
            <div class="line ai-stream">@((MarkupString)RenderMarkdown(_streamBuf.ToString()))</div>
        }
        @if (_busy && _streamBuf.Length == 0 && _thinking is not null)
        {
            <div class="line thinking"><span class="spinner"></span>@_thinking</div>
        }
    </div>

    @if (_ready)
    {
        <div class="input-row">
            <span class="prompt-symbol">&gt;</span>
            <input @ref="_inputRef"
                   @bind="_inputText"
                   @bind:event="oninput"
                   @onkeydown="OnKeyDown"
                   class="chat-input"
                   disabled="@_busy"
                   placeholder="@(_busy ? "応答中..." : "質問を入力して Enter")"
                   autocomplete="off"
                   spellcheck="false" />
            @if (_busy)
            {
                <button class="stop-btn" @onclick="StopAsync" title="生成を停止 (緊急停止)">■ 停止</button>
            }
        </div>
    }
    <footer class="app-footer terminal-footer">
        <a class="url" href="terms.html" target="_blank" rel="noopener">利用規約 (Terms of Use)</a>
        <span class="copyright">© 2026 kosmos.ebi</span>
    </footer>
</div>
}

@code {
    // ── UI state ────────────────────────────────────────────────────────────
    record Line(string Html, string Css = "");

    private readonly List<Line> _lines    = [];
    private readonly StringBuilder _streamBuf = new();
    private readonly List<ChatMessage> _history = [];

    private string _inputText = "";
    private bool   _accepted  = false;
    private bool   _ready     = false;
    private bool   _busy      = false;
    private string? _thinking = null;   // transient "processing" status during a turn
    private ElementReference _terminalRef;
    private ElementReference _outputRef;
    private ElementReference _inputRef;

    private CancellationTokenSource _cts = new();

    // Markdown pipeline — static, shared, thread-safe.
    private static readonly MarkdownPipeline _mdPipeline = new MarkdownPipelineBuilder()
        .UseAutoLinks()
        .UsePipeTables()
        .UseEmphasisExtras()
        .DisableHtml()        // don't allow raw HTML pass-through in LLM output
        .Build();

    // ── Lifecycle ───────────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Startup no longer runs automatically: the splash screen gates it behind
        // an explicit Accept click (see AcceptAsync). firstRender therefore does
        // nothing here — the boot sequence begins only once the user accepts.
        if (firstRender)
            return;
        // Auto-scroll to bottom after every render (streaming tokens, new lines, etc.)
        try { await JS.InvokeVoidAsync("scrollElementToBottom", _outputRef); } catch { }
    }

    // Splash → main transition. The terminal and boot sequence appear only after
    // the user clicks Accept; until then the splash gate is shown.
    private async Task AcceptAsync()
    {
        _accepted = true;
        StateHasChanged();
        await RunStartupAsync();
    }

    private async Task RunStartupAsync()
    {
        Print("=== AzureMoe Chat ===", "title");
        Print("GraphRAG + ブラウザ内 LLM", "dim");
        PrintBlank();

        try
        {
            // ── Step 1: manifest ──
            Status("manifest.json を読み込み中...");
            var manifest = await AssetLoader.LoadManifestAsync(_cts.Token);
            Print($"DB: {manifest.DatabaseFile}  " +
                  $"投稿 {manifest.PostCount} 件 / チャンク {manifest.ChunkCount} 件", "info");

            // ── Step 2: DB download ──
            Status("GraphDB をダウンロード中...");
            byte[]? dbBytes = null;
            var dbProg = new Progress<(long Recv, long Total)>(t =>
            {
                var pct = t.Total > 0 ? (int)(t.Recv * 100 / t.Total) : 0;
                Status($"GraphDB ダウンロード中... {pct}%  ({t.Recv / 1024:N0} KB)");
            });
            dbBytes = await AssetLoader.LoadDbAsync(manifest, dbProg, _cts.Token);
            Print($"DB ダウンロード完了 ({dbBytes.Length / 1024:N0} KB)", "ok");

            // ── Step 3: LadybugDB init ──
            Status("GraphDB を初期化中...");
            await GraphStore.InitAsync(dbBytes, _cts.Token);
            Print("GraphDB 初期化完了", "ok");

            // ── Step 4: Embedding model ──
            Status($"埋め込みモデルを読み込み中 ({Cfg.EmbeddingModelId})...");
            var embedProg = new Progress<(string File, int Pct)>(t =>
                Status($"埋め込みモデル: {t.File} {t.Pct}%"));
            await Embedder.LoadAsync(Cfg.EmbeddingModelId, embedProg, _cts.Token);
            Print("埋め込みモデル準備完了", "ok");

            // ── Step 5: LLM info (loaded on first query) ──
            var hasBuiltinAi = await LlmEngine.CheckBuiltinAiAsync(_cts.Token);
            if (hasBuiltinAi)
                Print("LLM: Chrome 組み込み AI (Gemini Nano)  利用可能 — ダウンロード不要", "info");
            else
                Print($"LLM: {Cfg.LlmModelId} ({Cfg.LlmDtype})  初回クエリ時に自動ダウンロード", "info");

            Print($"探索モード: {ModeLabel(Cfg.RetrievalMode)}  (/mode で変更)", "info");

            PrintBlank();
            PrintHelp();
            PrintBlank();
            _ready = true;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Print($"起動エラー: {ex.Message}", "error");
        }

        StateHasChanged();
        await FocusInputAsync();
    }

    // ── Input handling ──────────────────────────────────────────────────────

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _busy || string.IsNullOrWhiteSpace(_inputText))
            return;

        var input = _inputText.Trim();
        _inputText = "";
        await HandleInputAsync(input);
    }

    // Emergency stop: cancel the .NET pipeline (aborts the awaited LLM call) and
    // signal the worker to halt generation immediately.
    private async Task StopAsync()
    {
        if (!_busy) return;
        _thinking = "停止しています…";
        StateHasChanged();
        try { await LlmEngine.InterruptAsync(); } catch { }
        if (!_cts.IsCancellationRequested) await _cts.CancelAsync();
    }

    private async Task HandleInputAsync(string input)
    {
        PrintBlank();
        Print($"&gt; {EscapeHtml(input)}", "user-input");
        PrintBlank();

        // Built-in commands
        if (input.StartsWith('/') || input.StartsWith('\\'))
        {
            await HandleCommandAsync(input.TrimStart('/', '\\').Trim().ToLowerInvariant());
            return;
        }

        // RAG query
        _busy = true;
        // Fresh cancellation source per turn so the Stop button works repeatedly.
        _cts.Dispose();
        _cts = new CancellationTokenSource();
        StateHasChanged();
        try
        {
            // Load LLM on first use.
            // Priority: Chrome built-in AI (no download) → WebGPU → WASM CPU.
            if (!LlmEngine.IsLoaded)
            {
                var builtinAi = await LlmEngine.CheckBuiltinAiAsync(_cts.Token);
                if (builtinAi)
                    Status("LLM を初期化中 (Chrome 組み込み AI)...");
                else
                    Status($"LLM をダウンロード中 ({Cfg.LlmModelId})...");

                var llmProg = new Progress<(string Text, int Pct)>(t =>
                    Status($"LLM: {t.Text}  {t.Pct}%"));
                await LlmEngine.LoadAsync(Cfg.LlmModelId, Cfg.LlmDtype, llmProg, _cts.Token);
                Print($"LLM 準備完了  [{LlmEngine.Device}]", "ok");
                PrintBlank();
            }

            {
                IReadOnlyList<ChunkResult>? sources = null;
                _streamBuf.Clear();
                _thinking = "考えています…";
                StateHasChanged();

                sources = await Rag.RunAsync(
                    input, _history,
                    onToken: async delta =>
                    {
                        // First token arrived — replace the "thinking" indicator with the stream.
                        _thinking = null;
                        // _streamBuf holds raw text — Blazor's @ binding auto-escapes it.
                        _streamBuf.Append(delta);
                        StateHasChanged();
                        await Task.Yield();
                    },
                    onCompleted: full =>
                    {
                        // Render completed response as Markdown HTML.
                        Print(RenderMarkdown(full), "ai");
                        _streamBuf.Clear();
                        _history.Add(new ChatMessage("user", input));
                        _history.Add(new ChatMessage("assistant", full));
                        if (_history.Count > 20) _history.RemoveRange(0, 2);
                    },
                    onStatus: msg =>
                    {
                        // Show what the pipeline is doing (analysing / searching / generating).
                        _thinking = msg;
                        StateHasChanged();
                    },
                    onWarning: msg =>
                    {
                        // Grounding check flagged the answer as not fully supported.
                        Print(EscapeHtml(msg), "warn");
                        StateHasChanged();
                    },
                    onStreamReset: () =>
                    {
                        // Drop the previous (un-grounded) preview before regenerating.
                        _streamBuf.Clear();
                        StateHasChanged();
                    },
                    ct: _cts.Token);

                _thinking = null;
                StateHasChanged();
                PrintBlank();
                PrintSources(sources);
            }
        }
        catch (OperationCanceledException)
        {
            // Keep whatever was generated before the stop, then note the cancel.
            if (_streamBuf.Length > 0)
            {
                Print(RenderMarkdown(_streamBuf.ToString()), "ai");
                _streamBuf.Clear();
            }
            Print("⏹ 停止しました", "warn");
        }
        catch (Exception ex) { Print($"エラー: {EscapeHtml(ex.Message)}", "error"); }
        finally
        {
            _busy = false;
            _thinking = null;
            StateHasChanged();
            await FocusInputAsync();
        }
    }

    private async Task HandleCommandAsync(string cmd)
    {
        var parts = cmd.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var verb  = parts.Length > 0 ? parts[0] : "";
        var arg   = parts.Length > 1 ? parts[1] : "";

        switch (verb)
        {
            case "help":
                PrintHelp();
                break;
            case "mode":
                SetMode(arg);
                break;
            case "clear":
                _lines.Clear();
                _history.Clear();
                // Leave a marker so the cleared screen isn't just a black void.
                Print("=== AzureMoe Chat ===", "title");
                Print("画面と会話履歴をクリアしました。質問を入力してください。 (/help でコマンド一覧)", "dim");
                PrintBlank();
                break;
            case "license":
            case "licenses":
                PrintLicenses();
                break;
            case "history":
                Print($"履歴: {_history.Count / 2} ターン", "info");
                break;
            case "model":
                if (LlmEngine.IsLoaded && LlmEngine.Device == "built-in")
                {
                    Print($"LLM     : Chrome 組み込み AI (Gemini Nano)  [読み込み済み / built-in]", "info");
                }
                else
                {
                    var llmStatus = LlmEngine.IsLoaded ? $"[{LlmEngine.Device}]" : "[未読み込み]";
                    Print($"LLM     : {Cfg.LlmModelId} ({Cfg.LlmDtype})  {llmStatus}", "info");
                }
                Print($"埋め込み: {Cfg.EmbeddingModelId}", "info");
                Print($"探索モード: {ModeLabel(Cfg.RetrievalMode)}", "info");
                break;
            case "reload":
                _lines.Clear();
                _history.Clear();
                // Unload loaded models first so reload truly starts fresh,
                // rather than re-using the already-loaded LLM/embedding worker.
                _ready = false;
                await LlmEngine.UnloadAsync(_cts.Token);
                await Embedder.UnloadAsync(_cts.Token);
                await RunStartupAsync();
                return;
            default:
                Print($"不明なコマンド: /{cmd}  (/help で一覧)", "warn");
                break;
        }
        StateHasChanged();
    }

    // ── Output helpers ──────────────────────────────────────────────────────

    private void Print(string html, string css = "")         => _lines.Add(new Line(html, css));
    private void PrintBlank()                                => _lines.Add(new Line("&nbsp;", "blank"));
    private void Status(string msg)
    {
        // Replace last status line or append
        if (_lines.Count > 0 && _lines[^1].Css == "status")
            _lines[^1] = new Line(EscapeHtml(msg), "status");
        else
            _lines.Add(new Line(EscapeHtml(msg), "status"));
        StateHasChanged();
    }

    private void PrintHelp()
    {
        Print("コマンド:", "heading");
        Print("  /help     — このヘルプを表示", "dim");
        Print("  /mode [fast|normal|deep] — 探索の深さを表示/変更", "dim");
        Print("  /model    — 現在のモデル情報", "dim");
        Print("  /history  — 会話履歴の件数", "dim");
        Print("  /license  — ライセンス情報を表示", "dim");
        Print("  /clear    — 画面と会話履歴をクリア", "dim");
        Print("  /reload   — 再起動", "dim");
        Print("それ以外は RAG クエリとして実行されます", "dim");
    }

    private static string ModeLabel(RetrievalMode m) => m switch
    {
        RetrievalMode.Fast   => "Fast (高速・LLM1回)",
        RetrievalMode.Deep   => "Deep (高精度・LLM多用)",
        _                    => "Normal (バランス・LLM2回)",
    };

    private void SetMode(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg))
        {
            Print($"現在の探索モード: {ModeLabel(Cfg.RetrievalMode)}", "info");
            Print("変更: /mode fast | /mode normal | /mode deep", "dim");
            return;
        }

        if (Enum.TryParse<RetrievalMode>(arg, ignoreCase: true, out var mode))
        {
            Cfg.RetrievalMode = mode;
            Print($"探索モードを {ModeLabel(mode)} に変更しました。", "ok");
        }
        else
        {
            Print($"不明なモード: {EscapeHtml(arg)}  (fast / normal / deep のいずれか)", "warn");
        }
    }

    // Link helper — href is always a trusted literal we author below.
    private static string Link(string url, string text) =>
        $"<a class='url' href='{url}' target='_blank' rel='noopener'>{EscapeHtml(text)}</a>";

    private void PrintLicenses()
    {
        Print("ライセンス情報 (License / Third-Party Licenses)", "heading");
        Print("本アプリ本体および利用するモデル・ライブラリのライセンス一覧です。", "dim");
        PrintBlank();

        // ── This app ──
        Print("● 本アプリ (AzureMoe Chat)", "heading");
        Print("  MIT License — Copyright (c) 2026 kosmos.ebi", "info");
        Print("  " + Link("LICENSE", "LICENSE 全文 (リポジトリルート)"), "source");
        PrintBlank();

        // ── LLM model ──
        Print("● LLM モデル", "heading");
        Print($"  {EscapeHtml(Cfg.LlmModelId)}", "info");
        Print("  LFM Open License v1.0 (lfm1.0) — Liquid AI, Inc.", "dim");
        Print("  ⚠ このライセンスは再配布時に LICENSE ファイル本体の同梱が必要です。", "warn");
        Print("  " + Link("https://huggingface.co/LiquidAI/LFM2.5-1.2B-JP-202606/blob/main/LICENSE",
                          "LFM Open License v1.0 全文 (HuggingFace)"), "source");
        PrintBlank();

        // ── Embedding model ──
        Print("● 埋め込みモデル", "heading");
        Print($"  {EscapeHtml(Cfg.EmbeddingModelId)} — MIT License", "info");
        Print("  " + Link("https://huggingface.co/intfloat/multilingual-e5-small",
                          "intfloat/multilingual-e5-small"), "source");
        PrintBlank();

        // ── JavaScript libraries ──
        Print("● JavaScript ライブラリ", "heading");
        Print("  @huggingface/transformers 4.2.0 — Apache-2.0", "dim");
        Print("  onnxruntime-web (transformers.js 同梱) — MIT", "dim");
        Print("  @ladybugdb/wasm-core 0.17.1 — MIT", "dim");
        PrintBlank();

        // ── NuGet packages ──
        Print("● NuGet パッケージ", "heading");
        Print("  Markdig 0.37.0 — BSD-2-Clause", "dim");
        Print("  Microsoft.AspNetCore.Components.WebAssembly 10.0.9 — MIT", "dim");
        PrintBlank();

        Print("詳細・全文一覧: " + Link("licenses/THIRD-PARTY-NOTICES.md", "licenses/THIRD-PARTY-NOTICES.md"), "info");
    }

    private void PrintSources(IReadOnlyList<ChunkResult>? sources)
    {
        if (sources is null || sources.Count == 0) return;
        Print("参考記事:", "heading");
        for (var i = 0; i < sources.Count; i++)
        {
            var c    = sources[i];
            var sim  = (1.0 - c.Distance).ToString("F3");
            var date = c.Date.Length >= 10 ? c.Date[..10] : c.Date;
            Print($"<span class='rank'>[{i + 1}]</span> <span class='sim'>{sim}</span>  " +
                  $"<a class='url' href='{EscapeHtml(c.Url)}' target='_blank'>{EscapeHtml(c.Title)}</a>" +
                  $"  <span class='dim'>{date}</span>", "source");
        }
    }

    // Converts markdown to safe HTML. Raw HTML pass-through is disabled (DisableHtml).
    private static string RenderMarkdown(string text)
        => Markdown.ToHtml(text, _mdPipeline);

    private static string EscapeHtml(string s) =>
        s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;");

    private async Task FocusInputAsync()
    {
        try { await _inputRef.FocusAsync(); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
