<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AzureMoe.Chat.Web</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <!-- Release-only: AOT-compile to WASM for runtime speed, then strip the managed IL
       that AOT makes redundant to claw back the size AOT adds. Brotli/gzip compression
       of published assets is on by default for Blazor WASM. Only takes effect on
       `dotnet publish` (AOT is a publish-time step), so dev/Debug builds stay fast. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <!-- The LadybugDB sync bundle is copied out of node_modules into wwwroot/lib at
       build time (see CopyLadybugRuntime). That generated copy is registered as a
       static web asset explicitly there, so remove it from the default Content glob
       to avoid an NETSDK1022 duplicate-Content error. -->
  <ItemGroup>
    <Content Remove="wwwroot\lib\ladybug\**" />
  </ItemGroup>

  <!-- npm install @ladybugdb/wasm-core into wwwroot/node_modules on first build.
       Hooked before static-asset resolution (not just Build) so the bundle exists
       before CopyLadybugRuntime needs it. -->
  <Target Name="NpmInstall" BeforeTargets="ResolveProjectStaticWebAssets;Build" Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/node_modules')">
    <Message Text="Running npm install in wwwroot..." Importance="high" />
    <Exec Command="npm install --quiet" WorkingDirectory="$(MSBuildProjectDirectory)/wwwroot" />
  </Target>

  <!-- node_modules is excluded from static web assets, so the worker's import would
       404 on publish. Copy the self-contained sync bundle (WASM embedded as a data
       URL — single file, no relative imports) into wwwroot/lib/ladybug and register
       it as a static web asset, so it lands in the build manifest and is served both
       in dev and after publish. Runs before ResolveProjectStaticWebAssets so the
       freshly-copied file is included in this same build. -->
  <Target Name="CopyLadybugRuntime"
          DependsOnTargets="NpmInstall"
          BeforeTargets="ResolveProjectStaticWebAssets;Build"
          Inputs="wwwroot\node_modules\@ladybugdb\wasm-core\sync\index.js"
          Outputs="wwwroot\lib\ladybug\index.js">
    <Copy SourceFiles="wwwroot\node_modules\@ladybugdb\wasm-core\sync\index.js"
          DestinationFiles="wwwroot\lib\ladybug\index.js"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Register the generated bundle as a Content item (and thus a static web asset).
       Kept separate from CopyLadybugRuntime's incremental Inputs/Outputs so the item
       is added on every build, even when the copy itself is skipped as up-to-date. -->
  <Target Name="IncludeLadybugRuntimeAsset"
          DependsOnTargets="CopyLadybugRuntime"
          BeforeTargets="ResolveProjectStaticWebAssets;Build">
    <ItemGroup>
      <Content Include="wwwroot\lib\ladybug\index.js" />
    </ItemGroup>
  </Target>

</Project>
